+package minigames.animalrun.Worldobject;
+
+import minigames.animalrun.*;
+import sas.Circle;
+import common.ScalablePicture;
+import controller.AbstractController;
+import sas.Picture;
+import sas.View;
+
+import java.awt.*;
+import java.util.stream.Collector;
+
+public abstract class Tumbleweed extends Picture implements WorldObject {
+
+    private minigames.animalRun.Monkey monkeys[];
+    private View view;
+
+    public Tumbleweed(double xp, double yp, String name, View view) {
+        super(xp, yp, name);
+        moveTo(view.getWidth(), 100);
+    }
+
+
+    @Override
+    public void doThings(int tick) {
+
+        monkeys = (minigames.animalRun.Monkey[]) AnimalRun.getWorldObjects().stream().filter(o -> o instanceof minigames.animalRun.Monkey).toArray();
+
+        if (intersects(platform)) {
+            move(-1, 0);
+        }
+
+        turn(45);
+        view.wait(20);
+
+
+        if (getShapeX() < 0) {
+            setHidden(true);
+            view.remove(this);
+        }
+
+        if (intersects(monkeys[0])) {
+            monkeys[2].moveTo(monkeys[0].getShapeX(), monkeys[0].getShapeY());
+            monkeys[0].setHidden(true);
+            view.remove(monkeys[0]);
+            for (int i = 0; i < 40; i++) {
+                monkeys[2].move(1, -1);
+                view.wait(3);
+            }
+            for (int i = 0; i < view.getHeight() + monkeys[2].getShapeHeight(); i++) {
+                monkeys[2].move(0, 1);
+                view.wait(1);
+            }
+            monkeys[2].setHidden(true);
+            view.remove(monkeys[2]);
+        } else if (intersects(monkeys[1])) {
+            monkeys[2].moveTo(monkeys[1].getShapeX(), monkeys[1].getShapeY());
+            monkeys[1].setHidden(true);
+            view.remove(monkeys[1]);
+            for (int i = 0; i < 40; i++) {
+                monkeys[2].move(1, -1);
+                view.wait(3);
+            }
+            for (int i = 0; i < view.getHeight() + monkeys[2].getShapeHeight(); i++) {
+                monkeys[2].move(0, 1);
+                view.wait(1);
+            }
+            monkeys[2].setHidden(true);
+            view.remove(monkeys[2]);
+        }
+    }
+
+    @Override
+    public void updatePos() {
+
+    }
+
+    @Override
+    public boolean isSollit() {
+        return false;
+    }
+}
